from datetime import datetime

filename = 'auth_ts.log'
attempts = []


try:
    with open(filename, 'r') as f:
        for line in f:
            if 'Failed' in line:
                timestamp = line[:19] 
                parsed = datetime.strptime(timestamp, '%Y-%m-%d %H:%M:%S')                
                attempts.append(parsed)
                





                
except FileNotFoundError:
    print('file not found')
